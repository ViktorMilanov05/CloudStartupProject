{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=CloudStartupProject;Trusted_Connection=true;TrustServerCertificate=true;"
  },
  "Jwt": {
    "Secret": "CHANGE-THIS-TO-A-SECURE-256-BIT-KEY-IN-PRODUCTION-!",
    "Issuer": "CloudStartupProject",
    "Audience": "CloudStartupProject",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 7
  },
  "FileStorage": {
    "BasePath": "Uploads",
    "MaxFileSizeMB": 25
  },
  "Cleanup": {
    "IntervalHours": 24,
    "NotificationRetentionDays": 30,
    "OrphanedImageRetentionDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:8080" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
